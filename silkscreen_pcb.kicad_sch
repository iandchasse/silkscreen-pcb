	(text "USB / CHARGE STATUS ADC DIVIDER NOTE:\nMonitors TPS2116 ST and TP4056 CHRG/STDBY via single ADC pin (USB_STAT).\nMax continuous current draw: < 30 uA.\n\nPRIMARY OPERATIONAL STATES:\n1) Discharging / Unplugged (VIN2 Active):   ~1.98 V  [Window: 1.70 V - 2.20 V]\n2) Plugged in & Actively Charging:          ~1.18 V  [Window: 1.00 V - 1.35 V]\n3) Plugged in & Fully Charged (Done):       ~0.59 V  [Window: 0.50 V - 0.70 V]\n4) Plugged in & Charger Idle/Disabled:      ~3.30 V  [Window: > 3.10 V]\n\nFAULT / TRANSIENT:\n- No Battery / Oscillation: Toggles rapidly between ~0.59 V and ~0.45 V."
		(exclude_from_sim no)
		(at 477.52 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0909e84f-2aee-4862-8643-39134cd84767")
	)
